# Copy to .env for reference. "npm run dev" starts a local database automatically.
DATABASE_URL=postgres://user:password@host/dbname
JWT_SECRET=any-long-random-string
ADMIN_EMAILS=you@ucsd.edu,teammate@ucsd.edu
# Optional AI provider for the Administrator's answers (one of these):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
# Optional Mapbox public token (pk.) for maps and road routes in the chat
MAPBOX_TOKEN=
# Testing knobs
# 0.25 makes every stage four times shorter
TIME_SCALE=1
# Play now: wait before AI players fill empty seats
FILL_AFTER_SECONDS=60
# Play now: wait for a 4th or 5th player once 3 are here
GATHER_SECONDS=10
